# Option 1: Copy to terraform.tfvars (gitignored)
# Option 2: Use environment variables (recommended):
#   export TF_VAR_cloudflare_api_token="your-token"
#   export TF_VAR_cloudflare_account_id="your-account-id"

cloudflare_api_token  = ""  # or use TF_VAR_cloudflare_api_token
cloudflare_account_id = ""  # or use TF_VAR_cloudflare_account_id

# Get account ID: wrangler whoami
# Create API token: Cloudflare Dashboard → My Profile → API Tokens

# Optional: for custom domain routing
# cloudflare_zone_id = ""
